<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta name="theme-color" content="#e30613">

  <link rel="manifest" href="manifest.json">
  <link rel="stylesheet" href="style.css">

  <title>AL HASSAN</title>
</head>

<body>

  <header class="top">
    <div class="brand">AL HASSAN</div>
    <div class="loc">📍 درعا</div>
  </header>

  <main>

    <section class="hero">
      <h1>شو بدك تطلب اليوم؟</h1>

      <div class="search">
        🔎
        <input
          id="search"
          type="text"
          placeholder="ابحث عن مطعم أو وجبة..."
        >
      </div>
    </section>

    <section>
      <h2>التصنيفات</h2>

      <div class="cats">
        <button>🍔 برغر</button>
        <button>🍕 بيتزا</button>
        <button>🍗 وجبات</button>
        <button>🥤 مشروبات</button>
        <button>🛒 بقالة</button>
      </div>
    </section>

    <section>

      <div class="section-head">
        <h2>مطاعم قريبة منك</h2>
        <span>عرض الكل</span>
      </div>

      <div id="restaurants" class="grid"></div>

    </section>

    <section>

      <h2>🛒 سلة الطلب</h2>

      <div id="cart" class="cart">
        السلة فارغة
      </div>

      <button id="checkout" class="primary">
        متابعة الطلب
      </button>

    </section>

  </main>

  <nav class="bottom">

    <button>
      🏠
      <small>الرئيسية</small>
    </button>

    <button>
      🔎
      <small>بحث</small>
    </button>

    <button>
      📦
      <small>طلباتي</small>
    </button>

    <button>
      👤
      <small>حسابي</small>
    </button>

  </nav>

  <script src="app.js"></script>

</body>
</html>
